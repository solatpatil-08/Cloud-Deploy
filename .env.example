# ==============================================================================
# CloudDeploy Environment Configuration Template
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# Application Environment Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (PostgreSQL)
DB_NAME=clouddeploy_db
DB_USERNAME=clouddeploy_user
# Use a strong randomly generated password in production:
DB_PASSWORD=ChangeThisToAStrongSecurePassword123!

# JWT Authentication Security (Minimum 256-bit / 32-character secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Nginx Host Port Bindings
HTTP_PORT=80
HTTPS_PORT=443

# Grafana Administrator Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPassword2026!

# AWS ECR Image Pull Configuration (for compose.prod.yaml)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=clouddeploy-task-manager
IMAGE_TAG=latest
